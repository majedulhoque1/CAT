# Vite client (build-time)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin bootstrap (see supabase/migrations/0010_admin_gate_unification.sql)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase Management API PAT — used to apply migrations / deploy the edge
# function via curl when the Supabase CLI isn't usable locally.
SUPABASE_ACCESS_TOKEN=

